# Referência para PostgreSQL gerenciado; não contém credenciais.
# Não substitua o .env local automaticamente. Cadastre os valores no painel Vercel.
DATABASE_URL=
DATABASE_SSL=true
# PEM completo somente se o provedor exigir uma CA própria.
DATABASE_SSL_CA=
DATABASE_POOL_MAX=2
# Alternativa à URL: os cinco campos locais existentes.
DATABASE_HOST=
DATABASE_PORT=5432
DATABASE_NAME=
DATABASE_USER=
DATABASE_PASSWORD=
# Origem HTTPS exata e estável; sem caminho, curingas ou barra final.
AUTH_ORIGIN=https://mars-estate.example.invalid
GEMINI_API_KEY=
# Opcional: configure apenas um modelo disponível para sua chave.
GEMINI_MODEL=
